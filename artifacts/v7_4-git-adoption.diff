+/* ---------------------------------------------------------------------------
+   Studio layout + shared component classes.
+   Tokens and base typography live in index.css; keep values in sync with src/theme.js.
+   Visual language: notebook-style white "cells" on a light neutral canvas, hairline rules,
+   small radii, one red-orange accent for primary actions, steel blue for secondary controls.
+   --------------------------------------------------------------------------- */
+
+/* ---- Top bar ------------------------------------------------------------- */
+.hg-topbar {
+  position: sticky;
+  top: 0;
+  z-index: 20;
+  background: var(--hg-surface);
+  border-top: 3px solid var(--hg-accent);
+  border-bottom: 1px solid var(--hg-border);
+}
+
+.hg-topbar__inner {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  max-width: 1320px;
+  height: 52px;
+  margin: 0 auto;
+  padding: 0 24px;
+}
+
+.hg-brand {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex: 0 0 auto;
+  width: 28px;
+  height: 28px;
+  color: #fff;
+  font-size: 16px;
+  background: var(--hg-accent);
+  border-radius: var(--hg-radius);
+}
+
+.hg-title {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  line-height: 1.15;
+}
+
+.hg-title__name {
+  font-family: var(--hg-font-serif);
+  font-size: 17px;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  color: var(--hg-text);
+  white-space: nowrap;
+}
+
+.hg-title__sub {
+  margin-top: 2px;
+  font-size: 11.5px;
+  color: var(--hg-text-faint);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.hg-notice {
+  padding: 3px 10px;
+  font-size: 12.5px;
+  font-weight: 500;
+  color: var(--hg-green);
+  background: var(--hg-green-lt);
+  border: 1px solid #BFE0CB;
+  border-radius: var(--hg-radius);
+}
+
+.hg-topbar__tag {
+  font-family: var(--hg-font-mono);
+  font-size: 12px;
+  color: var(--hg-text-faint);
+  white-space: nowrap;
+}
+
+/* ---- Page shell ---------------------------------------------------------- */
+.hg-shell {
+  width: 100%;
+  max-width: 1320px;
+  margin: 0 auto;
+  padding: 18px 24px 64px;
