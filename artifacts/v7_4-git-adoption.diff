+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 10px;
+}
+
+.hg-card__title {
+  font-family: var(--hg-font-serif);
+  font-size: 16px;
+  font-weight: 600;
+  letter-spacing: -0.005em;
+  color: var(--hg-text);
+}
+
+.hg-card__actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+/* ---- Buttons ------------------------------------------------------------- */
+.hg-btn {
+  padding: 5px 12px;
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1.4;
+  color: var(--hg-text);
+  background: var(--hg-surface);
+  border: 1px solid var(--hg-border-strong);
+  border-radius: var(--hg-radius);
+  cursor: pointer;
+}
+
+.hg-btn:not(:disabled):hover {
+  background: var(--hg-card);
+  filter: none;
+}
+
+.hg-btn--info {
+  color: var(--hg-teal);
+  background: var(--hg-teal-lt);
+  border-color: #B7D0E1;
+  font-weight: 600;
+}
+
+.hg-btn--info:not(:disabled):hover {
+  background: #DDEAF3;
+}
+
+.hg-btn--link {
+  padding: 0;
+  font-weight: 600;
+  color: var(--hg-teal);
+  background: none;
+  border: none;
+}
+
+.hg-btn--link:not(:disabled):hover {
+  background: none;
+  text-decoration: underline;
+}
+
+.hg-btn--primary {
+  font-weight: 600;
+  color: #fff;
+  background: var(--hg-accent);
+  border-color: var(--hg-accent);
+}
+
+.hg-btn--primary:not(:disabled):hover {
+  background: var(--hg-accent-dark);
+  border-color: var(--hg-accent-dark);
+}
+
+.hg-btn--primary:disabled {
+  background: #B9BEC4;
+  border-color: #B9BEC4;
+}
+
+.hg-btn--lg {
+  padding: 8px 24px;
+  font-size: 14px;
+}
+
+.hg-convert-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 12px;
+  margin-top: 12px;
+}
+
+.hg-msg--error {
+  font-size: 13.5px;
+  font-weight: 500;
+  color: var(--hg-rose);
+}
+
+.hg-msg--warn {
+  font-size: 13px;
+  color: var(--hg-amber);
+}
+
+/* ---- Statistic strip (cells joined by hairlines) ------------------------- */
+.hg-stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
+  margin-bottom: 14px;
+  overflow: hidden;
+  background: var(--hg-surface);
+  border-top: 1px solid var(--hg-border);
+  border-left: 1px solid var(--hg-border);
+  border-radius: var(--hg-radius-lg);
+  box-shadow: var(--hg-shadow-sm);
+}
+
+.hg-stat {
+  padding: 9px 14px 10px;
+  background: var(--hg-surface);
+  border-right: 1px solid var(--hg-border);
+  border-bottom: 1px solid var(--hg-border);
+}
+
+.hg-stat__label {
+  margin-bottom: 3px;
+  font-size: 10.5px;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--hg-text-faint);
+}
+
+.hg-stat__value {
+  font-family: var(--hg-font-mono);
+  font-size: 21px;
+  font-weight: 600;
+  line-height: 1.1;
+  color: var(--hg-text);
+}
+
+/* ---- Committed-graph meta strip ------------------------------------------ */
+.hg-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px 28px;
+  padding: 10px 16px;
+}
+
+.hg-meta__value {
+  font-family: var(--hg-font-mono);
+  font-size: 12px;
+  color: var(--hg-text-dim);
+}
+
+.hg-meta__value--active {
+  color: var(--hg-accent);
