+.hg-mapping {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.hg-mapping__title {
+  margin-bottom: 5px;
+  font-family: var(--hg-font-mono);
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
