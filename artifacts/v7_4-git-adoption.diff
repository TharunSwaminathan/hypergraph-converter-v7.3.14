+
+.hg-pill__label {
+  max-width: 100%;
+  font-size: 13.5px;
+  font-weight: 600;
+  line-height: 1.25;
+  color: var(--hg-text);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.hg-pill__sub {
+  max-width: 100%;
+  font-family: var(--hg-font-mono);
+  font-size: 10.5px;
+  line-height: 1.3;
+  color: var(--hg-text-faint);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
