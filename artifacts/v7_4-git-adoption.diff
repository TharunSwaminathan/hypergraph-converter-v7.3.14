+  coordinator.begin({ requestId: "new" });
+  state = { ...state, localModel: { ...state.localModel, request: coordinator.getSnapshot() } }; await render();
+  assert.doesNotMatch(host.querySelector(".agent-status").textContent, /Stopping/);
