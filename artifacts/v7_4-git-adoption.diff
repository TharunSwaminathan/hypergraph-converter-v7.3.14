+  background: var(--hg-card);
+  border-top: 1px solid var(--hg-border);
+}
+
+.hg-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-family: var(--hg-font-mono);
+  font-size: 12px;
+}
+
+.hg-table thead th {
+  position: sticky;
+  top: 0;
+  z-index: 1;
+  padding: 5px 10px;
+  text-align: left;
+  font-family: var(--hg-font-sans);
+  font-size: 10.5px;
+  font-weight: 600;
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+  white-space: nowrap;
+  color: var(--hg-text-dim);
+  background: var(--hg-card);
+  border-bottom: 1px solid var(--hg-border-strong);
+}
+
+.hg-table td {
+  max-width: 300px;
+  padding: 4px 10px;
+  line-height: 1.4;
+  word-break: break-all;
+  color: var(--hg-text);
+  border-bottom: 1px solid #EEF0F2;
+}
+
+.hg-table tbody tr:last-child td {
+  border-bottom: none;
+}
+
+.hg-table tbody tr:hover td {
+  background: var(--hg-card);
+}
+
+.hg-table__key {
+  font-weight: 600;
+}
+
+/* ---- Dynamic Hypergraph update panel -------------------------------------- */
+.hg-update-panel {
+  margin-top: 16px;
+  background: var(--hg-surface);
+}
+
+.hg-update-panel h3 {
+  margin: 0 0 6px;
+  font-size: 17px;
+}
+
+.hg-update-panel p {
+  margin: 6px 0;
+  font-size: 13px;
+  line-height: 1.55;
+  color: var(--hg-text-dim);
+}
+
+.hg-update-panel .agent-model__details {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
+  margin: 12px 0;
+  overflow: hidden;
+  border-top: 1px solid var(--hg-border);
+  border-left: 1px solid var(--hg-border);
+  border-radius: var(--hg-radius);
+}
+
+.hg-update-panel .agent-model__details > div {
+  padding: 7px 12px 8px;
+  background: var(--hg-surface);
+  border-right: 1px solid var(--hg-border);
+  border-bottom: 1px solid var(--hg-border);
+}
+
+.hg-update-panel .agent-model__details dt {
+  margin-bottom: 2px;
+  font-size: 10.5px;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--hg-text-faint);
+}
+
+.hg-update-panel .agent-model__details dd {
+  margin: 0;
+  font-family: var(--hg-font-mono);
+  font-size: 12px;
+  color: var(--hg-text);
+  overflow-wrap: anywhere;
+}
+
+.hg-update-panel .agent-file-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin: 10px 0;
+}
+
+.hg-update-panel .agent-file-actions button,
+.hg-update-panel [role="group"] button {
+  padding: 5px 12px;
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--hg-text);
+  background: var(--hg-surface);
+  border: 1px solid var(--hg-border-strong);
+  border-radius: var(--hg-radius);
+  cursor: pointer;
+}
+
+.hg-update-panel .agent-file-actions button:disabled,
+.hg-update-panel [role="group"] button:disabled {
+  color: var(--hg-text-faint);
+  background: var(--hg-card);
+  border-color: var(--hg-border);
+  cursor: not-allowed;
+}
+
+.hg-update-panel [role="group"] {
+  margin: 10px 0;
+  padding: 12px 14px;
+  background: var(--hg-amber-lt);
+  border: 1px solid #E3C77E !important;
+  border-radius: var(--hg-radius);
+}
+
+/* ---- Responsive ------------------------------------------------------------ */
+@media (max-width: 900px) {
+  .hg-title__sub,
+  .hg-topbar__tag {
+    display: none;
+  }
+
+  .hg-meta__note {
+    max-width: none;
+    margin-left: 0;
+  }
+}
+
+@media (max-width: 640px) {
+  .hg-topbar__inner {
+    padding: 0 14px;
+  }
+
+  .hg-shell {
+    padding: 14px 14px 48px;
+  }
+
+  .hg-formats__group {
+    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
+  }
+
+  .hg-card {
+    padding: 12px;
+  }
+
+  .hg-tab {
+    padding: 9px 12px;
+  }
+}
