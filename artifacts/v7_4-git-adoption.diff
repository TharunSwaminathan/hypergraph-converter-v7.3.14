+
+.hg-select {
+  padding: 4px 8px;
+  font-size: 12.5px;
+  font-weight: 600;
+  letter-spacing: 0;
+  text-transform: none;
+  color: var(--hg-text);
+  background: var(--hg-surface);
+  border: 1px solid var(--hg-border-strong);
+  border-radius: var(--hg-radius);
+}
+
+/* ---- Tabs ----------------------------------------------------------------- */
+.hg-tabs {
+  display: flex;
+  gap: 2px;
+  margin: 4px 0 14px;
+  overflow-x: auto;
+  border-bottom: 1px solid var(--hg-border);
+}
+
+.hg-tab {
+  flex: 0 0 auto;
+  padding: 9px 16px;
+  margin-bottom: -1px;
+  font-size: 14px;
+  font-weight: 500;
+  color: var(--hg-text-dim);
+  background: transparent;
+  border: none;
+  border-bottom: 2px solid transparent;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.hg-tab:not(:disabled):hover {
+  color: var(--hg-text);
+  filter: none;
+}
+
+.hg-tab.is-active {
+  font-weight: 600;
+  color: var(--hg-accent);
+  border-bottom-color: var(--hg-accent);
+}
+
+.hg-tools {
+  margin-top: 28px;
+}
+
+/* ---- Derived-view chips --------------------------------------------------- */
+.hg-chiprow {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  margin-bottom: 12px;
+}
+
+.hg-chiprow__label {
+  margin-right: 4px;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+  color: var(--hg-text-faint);
+}
+
+.hg-chiprow__note {
+  margin-left: 6px;
+  font-size: 11.5px;
+  color: var(--hg-text-faint);
+}
+
+.hg-chip {
+  padding: 4px 11px;
+  font-size: 12.5px;
+  font-weight: 500;
+  color: var(--hg-text-dim);
+  background: var(--hg-surface);
+  border: 1px solid var(--hg-border-strong);
+  border-radius: var(--hg-radius);
+  cursor: pointer;
+}
+
+.hg-chip:not(:disabled):hover {
+  background: var(--hg-card);
+  filter: none;
+}
+
+.hg-chip.is-active {
+  font-weight: 600;
+  color: var(--hg-accent);
+  background: var(--hg-accent-lt);
+  border-color: var(--hg-accent);
