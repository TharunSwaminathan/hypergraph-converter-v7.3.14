+
+.hg-formats__group {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(176px, 1fr));
+  gap: 8px;
+}
+
+.hg-formats__label {
+  grid-column: 1 / -1;
+}
+
+.hg-pill {
