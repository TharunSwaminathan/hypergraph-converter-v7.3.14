+
+.hg-mapping__scroll {
+  max-height: 190px;
+  overflow: auto;
+}
+
+.hg-mapping__more {
+  padding: 6px 10px;
+  font-size: 11.5px;
+  color: var(--hg-text-faint);
+  background: var(--hg-surface);
+}
+
+.hg-mapping__text {
