                      "required": [
                        "hyperedges",
                        "vertices",
                        "incidences",
                        "incidenceIndexBuilds",
                        "candidatePairWork",
                        "uniqueProjectedEdges",
                        "adjacencyReferences",
                        "synchronousWork",
                        "elapsedMs"
                      ],
                      "properties": {
                        "hyperedges": {
                          "type": "number",
                          "minimum": 0
                        },
                        "vertices": {
                          "type": "number",
                          "minimum": 0
                        },
                        "incidences": {
                          "type": "number",
                          "minimum": 0
                        },
                        "incidenceIndexBuilds": {
                          "type": "number",
                          "minimum": 0
